// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- IDENTITY & ACCESS (IAM) ---
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  stockMovements StockMovement[]
  auditLogs      AuditLog[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json?
  users       User[]
}

// --- MASTER DATA ---
model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  unit        String
  purchasePrice Float
  salePrice     Float?
  minStockLevel Int      @default(0)

  stocks      Stock[]
  movements   StockMovement[]
  bom         BillOfMaterials?
  purchaseItems PurchaseOrderItem[]
  salesItems    SalesOrderItem[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String
  stocks    Stock[]
  movements StockMovement[]
}

// --- INVENTORY ---
model Stock {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  type        MovementType
  quantity    Int
  referenceId String?
  userId      String
  createdAt   DateTime  @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  PRODUCTION_USE
  PRODUCTION_FINISH
}

// --- PROCUREMENT & PRODUCTION ---
model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String
  email     String
  orders    PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  supplierId  String
  status      POStatus @default(DRAFT)
  totalAmount Float
  createdAt   DateTime @default(now())

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

enum POStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Float

  order           PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model BillOfMaterials {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  items       BOMItem[]
}

model BOMItem {
  id          String   @id @default(uuid())
  bomId       String
  materialId  String
  quantity    Int

  bom         BillOfMaterials @relation(fields: [bomId], references: [id])
}

// --- SALES MODULE ---
model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]
}

model SalesOrder {
  id          String   @id @default(uuid())
  customerId  String
  status      String
  totalAmount Float
  createdAt   DateTime @default(now())

  customer Customer        @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]
}

model SalesOrderItem {
  id           String @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  price        Float

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

// --- SYSTEM LOGS & AI ---
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AIDocument {
  id          String   @id @default(uuid())
  title       String
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())
}
