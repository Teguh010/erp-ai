// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- IDENTITY & ACCESS (IAM) ---
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  deletedAt     DateTime? // Soft delete

  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@index([roleId])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json?
  users       User[]
}

// --- MASTER DATA ---
model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  unit        String
  purchasePrice Float
  salePrice     Float?
  minStockLevel Int      @default(0)
  deletedAt     DateTime? // Soft delete

  stocks      Stock[]
  movements   StockMovement[]
  bom         BillOfMaterials?
  bomItemsAsMaterial BOMItem[]
  purchaseItems PurchaseOrderItem[]
  salesItems    SalesOrderItem[]

  @@index([categoryId])
  @@index([name])
  @@index([minStockLevel])
  @@index([deletedAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  deletedAt DateTime? // Soft delete
  products  Product[]

  @@index([deletedAt])
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String
  location  String
  deletedAt DateTime? // Soft delete
  stocks    Stock[]
  movements StockMovement[]

  @@index([name])
  @@index([deletedAt])
}

// --- INVENTORY ---
model Stock {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([quantity])
}

model StockMovement {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  type        MovementType
  quantity    Int
  referenceId String?
  userId      String
  createdAt   DateTime  @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  PRODUCTION_USE
  PRODUCTION_FINISH
}

// --- PROCUREMENT & PRODUCTION ---
model Supplier {
  id        String    @id @default(uuid())
  name      String
  contact   String
  email     String
  deletedAt DateTime? // Soft delete
  orders    PurchaseOrder[]

  @@index([name])
  @@index([email])
  @@index([deletedAt])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  supplierId  String
  status      POStatus @default(DRAFT)
  totalAmount Float
  createdAt   DateTime @default(now())

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

enum POStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Float

  order           PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model BillOfMaterials {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  items       BOMItem[]
  productionOrders ProductionOrder[]
}

model BOMItem {
  id          String   @id @default(uuid())
  bomId       String
  materialId  String
  quantity    Int

  bom         BillOfMaterials @relation(fields: [bomId], references: [id])
  material    Product         @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
}

// --- PRODUCTION ORDERS ---
model ProductionOrder {
  id            String   @id @default(uuid())
  bomId         String
  quantity      Int
  status        ProductionStatus @default(PENDING)
  scheduledDate DateTime?
  completedDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bom           BillOfMaterials @relation(fields: [bomId], references: [id])

  @@index([bomId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
}

// --- LAPORAN PACKAGING (aktivitas produksi: tenaga, hasil, HPP) ---
model PackagingReport {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  aktivitas        String
  tenagaPerempuan  Int      @default(0)
  tenagaLaki       Int      @default(0)
  hasilPackaging   Int      @default(0)
  hpp              Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([aktivitas])
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- SALES MODULE ---
model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())

  salesOrders SalesOrder[]

  @@index([name])
  @@index([email])
  @@index([deletedAt])
}

model SalesOrder {
  id          String   @id @default(uuid())
  customerId  String
  status      String
  totalAmount Float
  createdAt   DateTime @default(now())

  customer Customer        @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SalesOrderItem {
  id           String @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  price        Float

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

// --- SYSTEM LOGS & AI ---
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
}

model AIDocument {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  chunks      AIDocumentChunk[]

  @@index([title])
  @@index([createdAt])
}

model AIDocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  content     String   @db.Text
  embedding   Json?    // Store vector as JSON for MySQL compatibility
  chunkIndex  Int
  createdAt   DateTime @default(now())

  document    AIDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
}
