# Database (matches docker-compose.yml at repo root)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/erp_db"

# HTTP API port (default 3000 — global prefix /api)
PORT=3000

# Required in production; any long random string is fine for development
JWT_SECRET="change-me-to-a-long-random-secret"

# Frontend dev (Next.js usually on port 3001)
CORS_ORIGIN=http://localhost:3001

# Optional — Redis from docker compose; falls back to in-memory cache if unavailable
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional — AI Assistant (Groq)
# GROQ_API_KEY=
